<view class="app {{themeClass}}">
  <view class="topbar">
    <text class="brand">明日穿什么</text>
    <text class="topnote">DAILY STYLE</text>
  </view>

  <view class="body">
    <block wx:if="{{page === 'home'}}">
      <view class="eyebrow">DAILY OUTFIT GUIDE</view>
      <view class="day-toggle">
        <button class="{{dateMode === 'today' ? 'selected' : ''}}" data-value="today" bindtap="setDateMode">今天</button>
        <button class="{{dateMode === 'tomorrow' ? 'selected' : ''}}" data-value="tomorrow" bindtap="setDateMode">明天</button>
      </view>
      <view class="hero">
        <view class="hero-ring ring-a"></view><view class="hero-ring ring-b"></view>
        <view class="hero-star">✦</view><view class="hero-sigil">搭</view>
        <view class="hero-content">
          <text class="hero-kicker">{{dateMode === 'tomorrow' ? '明日搭配' : '今日搭配'}} · {{targetDate}}</text>
          <text class="hero-title">你准备去什么场景？</text>
          <text class="hero-subtitle">从直觉画面开始，整理一套能照着准备的穿搭。</text>
        </view>
      </view>
      <view class="section-head"><text>选一个场景</text><text class="muted">按最接近的计划选择</text></view>
      <view class="theme-grid">
        <view class="theme-tile" wx:for="{{themes}}" wx:key="id" data-id="{{item.id}}" bindtap="beginTheme" role="button" aria-label="{{item.name}}" hover-class="theme-tile-pressed">
          <text class="theme-index">{{item.index}}</text><text class="theme-icon">{{item.icon}}</text><text class="theme-name">{{item.name}}</text>
        </view>
      </view>
      <view class="small-note">三幕场景选择 → 第一眼选物 → 天气、场合与衣橱方案</view>
    </block>

    <block wx:elif="{{page === 'quiz'}}">
      <view class="eyebrow">{{theme.icon}} {{theme.name}} · 第 {{qIndex + 1}} / 3 幕</view>
      <view class="progress"><view style="width:{{progress}}%"></view></view>
      <view class="scene-orb"><text>{{qIndex === 0 ? '☼' : qIndex === 1 ? '☾' : '✧'}}</text></view>
      <view class="page-title">{{questionText}}</view><view class="page-subtitle">想象画面，按第一反应选择。</view>
      <view class="option-stack"><button class="option {{item.selected ? 'chosen' : ''}}" wx:for="{{questionOptions}}" wx:key="index" data-index="{{item.index}}" bindtap="answer"><text class="option-mark">{{item.selected ? '✓' : '○'}}</text><text>{{item.text}}</text></button></view>
      <button class="primary" disabled="{{!canAdvance}}" bindtap="nextQuestion">{{qIndex === 2 ? '去选一件物品 →' : '下一幕 →'}}</button>
      <button class="text-button" bindtap="previousQuestion">← {{qIndex === 0 ? '换个场景' : '上一幕'}}</button>
    </block>

    <block wx:elif="{{page === 'draw'}}">
      <view class="eyebrow">{{theme.name}} · 直觉选物</view>
      <view class="page-title">第一眼，你想靠近哪一件？</view><view class="page-subtitle">先看图，选择与你此刻感觉最接近的一件。</view>
      <view class="object-grid"><button class="object-card" wx:for="{{objects}}" wx:key="index" data-index="{{item.index}}" bindtap="chooseObject" aria-label="选择{{item.name}}"><view class="object-frame"><image class="sheet-image" src="{{item.sheetSrc}}" style="{{item.imageStyle}}" mode="scaleToFill"></image></view><text class="object-num">NO. {{item.index + 1}}</text></button></view>
      <view class="small-note">这里没有标准答案，选择结果只用于整理你的偏好和行动提示。</view>
      <button class="text-button" bindtap="previousQuestion">← 返回上一幕</button>
    </block>

    <block wx:elif="{{page === 'reading'}}">
      <view class="eyebrow">{{theme.name}} · 选择结果</view>
      <view class="reading-card"><view class="reading-top"><text>YOUR REFLECTION</text><text>✦</text></view><view class="reading-symbol">{{reading.object.symbol}}</view><view class="reading-title">{{reading.title}}</view><view class="reading-caption">你先被「{{reading.object.name}}」吸引</view></view>
      <view class="insight-card"><text class="card-label">此刻的偏好</text><text class="insight-large">{{reading.summary}}</text><text class="insight-detail">你留下的画面：{{reading.wants}}</text></view>
      <view class="action-card"><text class="card-label">先做</text><text>{{reading.do}}</text></view>
      <view class="action-card"><text class="card-label">遇到变化</text><text>{{reading.reacts}}</text></view>
      <view class="action-card"><text class="card-label">可以先放下</text><text>{{reading.avoid}}</text></view>
      <button class="primary" data-page="conditions" bindtap="navigate">把提示变成穿搭方案 →</button>
      <view class="small-note">结果来自你的场景选择，用于日常整理和穿搭灵感。</view>
    </block>

    <block wx:elif="{{page === 'conditions'}}">
      <view class="eyebrow">把灵感落到生活里</view>
      <view class="page-title">{{dateMode === 'tomorrow' ? '明天' : '今天'}}的条件，补几项就好。</view><view class="page-subtitle">以下资料只用于生成穿搭建议。</view>
      <view class="field"><text class="field-label">当前所在城市</text><picker mode="multiSelector" range="{{currentRegionColumns}}" value="{{currentRegionIndices}}" bindcolumnchange="currentRegionColumnChange" bindchange="currentRegionChange" bindcancel="currentRegionCancel"><view class="picker-field region-picker">{{currentRegionLabel || '选择省份或地区、城市'}}<text>⌄</text></view></picker><text class="field-hint">选择一次后，系统会自动更新对应日期的天气。</text></view>
      <view class="forecast-card" wx:if="{{city}}"><text class="card-label">{{targetDate}} · 当地预报</text><text wx:if="{{forecastStatus === 'loading'}}">正在读取所选城市的预报…</text><block wx:elif="{{forecast && forecastStatus === 'ready'}}"><text class="forecast-main">{{forecast.description}} · {{forecast.tempMin}}–{{forecast.tempMax}}°C</text><text class="forecast-detail">{{weatherFactors}} · 已用于穿搭建议</text><text class="weather-attribution">{{forecast.attribution}}</text></block><text wx:elif="{{forecastStatus === 'not-configured' || forecastStatus === 'disabled'}}">天气服务暂不可用，方案不会猜测当地天气。</text><text wx:elif="{{forecastStatus === 'unsupported'}}">{{forecastError || '该城市暂未接入自动预报，方案不会猜测当地天气。'}}</text><text wx:elif="{{forecastStatus === 'error'}}">{{forecastError}}；方案不会猜测当地天气。</text></view>
      <view class="field"><text class="field-label">场合</text><view class="chip-row"><button class="chip {{occasion === item ? 'active' : ''}}" wx:for="{{occasions}}" wx:key="*this" data-key="occasion" data-value="{{item}}" bindtap="setField">{{item}}</button></view></view>
      <view class="field"><text class="field-label">活动环境</text><view class="chip-row"><button class="chip {{environment === '室内为主' ? 'active' : ''}}" data-key="environment" data-value="室内为主" bindtap="setField">室内为主</button><button class="chip {{environment === '户外较多' ? 'active' : ''}}" data-key="environment" data-value="户外较多" bindtap="setField">户外较多</button></view></view>
      <view class="field"><text class="field-label">年龄段 · 可跳过</text><view class="chip-row"><button class="chip {{ageBand === item ? 'active' : ''}}" wx:for="{{ageRanges}}" wx:key="*this" data-key="ageRange" data-value="{{item}}" bindtap="setField">{{item}}</button></view></view>
      <view class="field"><text class="field-label">喜欢的风格 · 选 1–3 种，先选的为主风格</text><view class="style-grid"><button class="style-chip {{item.selected ? 'active' : ''}}" wx:for="{{styles}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleStyle"><text>{{item.name}}</text><text class="style-mood">{{item.priority === 1 ? '主风格 · ' : item.priority > 1 ? '点缀 · ' : ''}}{{item.mood}}</text></button></view></view>
      <view class="inline-note">年龄只采用你主动选择的范围；不填写也可以继续。</view>
      <button class="primary" bindtap="goPlan">查看完整方案 →</button>
    </block>

    <block wx:elif="{{page === 'plan'}}">
      <view class="eyebrow">{{theme.name}} · {{dateMode === 'tomorrow' ? '明日' : '今日'}}方案</view><view class="page-title">照着准备就好。</view>
      <view class="plan-intro"><text class="plan-title">{{plan.title}}</text><text>{{plan.mood}}</text><text class="plan-context">{{city || '未填城市'}} · {{plan.weatherText}} · {{environment}} · {{ageBand || '年龄未提供'}}</text></view>
      <button class="text-button plan-adjust" data-page="conditions" bindtap="navigate">调整风格与场合 →</button>
      <view class="outfit-board" wx:if="{{plan && plan.photoCount}}"><view class="outfit-board-head"><text>从你的衣橱里搭</text><text>{{plan.photoCount}} / {{plan.items.length}} 件有照片</text></view><view class="outfit-grid"><view class="outfit-tile" wx:for="{{plan.items}}" wx:key="label"><image wx:if="{{item.photo}}" src="{{item.photo}}" mode="aspectFit"></image><view wx:else class="outfit-empty">待补照片</view><view class="outfit-caption"><text>{{item.label}} · {{item.value}}</text><text>{{item.owned ? '衣橱已有' : '参考'}}</text></view></view></view><text class="outfit-board-note">按当前条件挑选的单品照片；拼图展示，不代表上身效果。</text></view>
      <text class="weather-attribution plan-weather-source" wx:if="{{forecast}}">{{forecast.attribution}}</text>
      <view class="reason-panel"><text class="card-label">这份建议参考了</text><view class="reason-row" wx:for="{{plan.reasons}}" wx:key="key"><text>{{item.label}}</text><text>{{item.detail}}</text></view></view>
      <view class="plan-detail scene-detail"><text class="card-label">{{occasion}}这样搭</text><text>{{plan.sceneAdvice}}</text></view>
      <view class="section-head" id="outfit-list"><text>穿搭清单</text><text class="muted">已有物品优先</text></view>
      <view class="item-list"><view class="look-item" wx:for="{{plan.items}}" wx:key="label"><text class="item-label">{{item.label}}</text><text class="item-value">{{item.value}}</text><text class="owned" wx:if="{{item.owned}}">已有</text><text class="placeholder" wx:else>参考</text></view></view>
      <view class="plan-detail"><text class="card-label">妆容 · 发型</text><text>{{plan.makeup}}；{{plan.hair}}。不化妆时保留防晒和润唇即可。</text></view>
      <view class="plan-detail styling-detail"><text class="card-label">这套怎么穿更好看</text><text>{{plan.styling}}</text><text class="styling-material">配色：{{plan.palette}} · 质地：{{plan.fabric}}；已有单品保持原色。</text></view>
      <view class="plan-detail" wx:if="{{plan.readingStyling}}"><text class="card-label">你的选择带来的搭配提示</text><text>{{plan.readingStyling}}。</text><text>行动提醒：{{plan.readingAction}}</text><text class="styling-material">可以先放下：{{plan.readingAvoid}}</text></view>
      <view class="plan-detail"><text class="card-label">天气变化时</text><text>{{plan.reminder}}</text></view><view class="plan-detail"><text class="card-label">现有衣橱怎么替代</text><text>{{plan.substitute}}</text></view>
      <view class="section-head"><text>{{dateMode === 'tomorrow' ? '今晚准备' : '现在准备'}}</text></view><view class="prep-item" wx:for="{{plan.prep}}" wx:key="*this"><text>□</text><text>{{item}}</text></view>
      <view class="small-note">{{plan.photoCount ? '上方展示本次选中的自有单品照片。' : '未录入衣物照片；可先按文字清单准备。'}}实际穿搭以天气与舒适度为准。</view>
    </block>

    <block wx:elif="{{page === 'book'}}">
      <view class="eyebrow">ACTION CARD</view><view class="page-title">抽一张今天的行动卡。</view><view class="page-subtitle">把它当作一个可执行的小提示。</view>
      <view class="book-cover {{book ? 'opened' : ''}}" bindtap="flipBook"><view class="book-inner" wx:if="{{book}}"><text class="book-star">✦</text><text class="book-answer">{{book[0]}}</text><text class="book-action">现在可以做：{{book[1]}}</text></view><view class="book-inner" wx:else><text class="book-star">✦</text><text class="book-label">行动卡</text><text class="book-action">轻点翻开</text></view></view>
      <button class="primary" bindtap="flipBook">{{book ? '再看一张' : '查看提示'}}</button><view class="small-note">提示不会读取你的想法，也不会替你做决定。</view>
    </block>

    <block wx:elif="{{page === 'profile'}}">
      <view class="eyebrow">我的 · 偏好与衣橱</view><view class="page-title">把常穿的东西留在这里。</view><view class="page-subtitle">搭配方案会优先使用你已经拥有的物品。</view>
      <view class="profile-summary"><text>偏好风格：{{styleText}}</text></view>
      <view class="section-head"><text>我的衣橱</text><text class="muted">照片可选</text></view>
      <view class="wardrobe-category-line"><text>物品分类</text><picker mode="multiSelector" range="{{wardrobeCategoryColumns}}" value="{{wardrobeCategoryIndices}}" bindcolumnchange="wardrobeCategoryColumnChange" bindchange="wardrobeCategory"><view class="category-picker">{{wardrobeCategoryGroup}} / {{wardrobeCategory}}　⌄</view></picker></view>
      <view class="wardrobe-add"><input placeholder="例如：米白衬衫、牛仔半裙" value="{{wardrobeName}}" bindinput="wardrobeName" maxlength="30" /><button bindtap="addWardrobe">添加物品</button></view>
      <view class="small-note wardrobe-category-note">先选大类，再选具体单品；照片和其余类目都可不填。</view>
      <view class="wardrobe-photo-entry"><button bindtap="chooseWardrobePhoto">{{wardrobePhotoDraft ? '更换照片' : '为这件物品添加照片'}}</button><image wx:if="{{wardrobePhotoDraft}}" src="{{wardrobePhotoDraft}}" mode="aspectFill"></image><text wx:if="{{wardrobePhotoDraft}}" bindtap="clearWardrobePhotoDraft">移除照片</text><text wx:else>可从相册选择或拍照，名称请写清材质和厚薄。</text></view>
      <view class="wardrobe-row" wx:for="{{wardrobe}}" wx:key="id"><image wx:if="{{item.photo}}" src="{{item.photo}}" mode="aspectFill"></image><view wx:else class="wardrobe-no-photo">无图</view><view class="wardrobe-row-text"><text>{{item.category}} · {{item.name}}</text></view><button data-id="{{item.id}}" bindtap="removeWardrobe">删除</button></view>
      <view class="empty-wardrobe" wx:if="{{wardrobe.length === 0}}">先加一件常穿的衣服、鞋或配饰。</view>
      <view class="section-head wardrobe-gap-head"><text>未来补充清单</text><text class="muted">不影响当天方案</text></view><view class="small-note wardrobe-gap-note">只在准备长期补充衣橱时参考；每次先挑一件。</view>
      <view class="chip-row"><button class="chip {{wardrobeBudget === item ? 'active' : ''}}" wx:for="{{wardrobeBudgets}}" wx:key="*this" data-key="wardrobeBudget" data-value="{{item}}" bindtap="setField">{{item}}</button></view>
      <view class="wardrobe-gap-card" wx:for="{{wardrobeGaps}}" wx:key="id"><view><text class="wardrobe-gap-category">{{item.category}} · {{item.price}}</text><text class="wardrobe-gap-name">{{item.name}}</text></view><text>{{item.reason}}</text><button data-id="{{item.id}}" bindtap="copyWardrobeGap">复制搜索词</button></view>
      <view class="empty-wardrobe wardrobe-gap-empty" wx:if="{{wardrobeGaps.length === 0}}">当前预算下没有必须补充的基础单品；先继续使用已有衣橱。</view><view class="small-note">衣橱与照片只保存在本机，可随时逐件删除。</view>
    </block>
  </view>

  <view class="bottom-nav"><button class="nav-item {{item.active ? 'active' : ''}}" wx:for="{{nav}}" wx:key="id" data-page="{{item.id}}" bindtap="navigate"><text class="nav-icon">{{item.icon}}</text><text>{{item.name}}</text></button></view>
</view>
