.fashion-coat .piece-a, .fashion-cardigan .piece-a { left: 50%; top: 39rpx; width: 87rpx; height: 122rpx; transform: translateX(-50%); border-radius: 13rpx 13rpx 8rpx 8rpx; }
.fashion-coat .piece-b, .fashion-cardigan .piece-b { left: 24rpx; top: 55rpx; width: 31rpx; height: 99rpx; transform: rotate(18deg); border-radius: 14rpx; }
.fashion-coat .piece-c, .fashion-cardigan .piece-c { right: 24rpx; top: 55rpx; width: 31rpx; height: 99rpx; transform: rotate(-18deg); border-radius: 14rpx; }
.fashion-cardigan .piece-a { width: 78rpx; height: 103rpx; }
.fashion-dress .piece-a { left: 50%; top: 39rpx; width: 58rpx; height: 54rpx; transform: translateX(-50%); border-radius: 14rpx 14rpx 4rpx 4rpx; }
.fashion-dress .piece-b { left: 50%; top: 84rpx; width: 111rpx; height: 79rpx; transform: translateX(-50%); border-radius: 6rpx 6rpx 32rpx 32rpx; clip-path: polygon(31% 0,69% 0,100% 100%,0 100%); }
.fashion-dress .piece-c { display: none; }
.fashion-loafer .piece-a, .fashion-sneaker .piece-a, .fashion-boot .piece-a { left: 30rpx; top: 77rpx; width: 91rpx; height: 40rpx; transform: rotate(-8deg); border-radius: 23rpx 11rpx 11rpx 19rpx; }
.fashion-loafer .piece-b, .fashion-sneaker .piece-b, .fashion-boot .piece-b { right: 26rpx; top: 105rpx; width: 91rpx; height: 40rpx; transform: rotate(8deg); border-radius: 11rpx 23rpx 19rpx 11rpx; }
.fashion-loafer .piece-c, .fashion-sneaker .piece-c, .fashion-boot .piece-c { display: none; }
.fashion-sneaker .piece-a, .fashion-sneaker .piece-b { border-bottom: 7rpx solid #e8e0d0; }
.fashion-boot .piece-a, .fashion-boot .piece-b { height: 62rpx; border-radius: 10rpx 10rpx 20rpx 14rpx; }
.fashion-shoulderbag .piece-a, .fashion-crossbag .piece-a, .fashion-tote .piece-a { left: 50%; top: 73rpx; width: 102rpx; height: 73rpx; transform: translateX(-50%); border-radius: 9rpx 9rpx 17rpx 17rpx; }
.fashion-shoulderbag .piece-b, .fashion-crossbag .piece-b, .fashion-tote .piece-b { left: 50%; top: 43rpx; width: 74rpx; height: 63rpx; transform: translateX(-50%); border: 5rpx solid var(--garment-dark); border-bottom: 0; border-radius: 45rpx 45rpx 0 0; background: transparent; }
.fashion-crossbag .piece-b { width: 142rpx; height: 108rpx; transform: translateX(-50%) rotate(-27deg); border-width: 3rpx 0 0; border-radius: 50%; }
.fashion-tote .piece-a { width: 118rpx; height: 85rpx; }
.fashion-shoulderbag .piece-c, .fashion-crossbag .piece-c, .fashion-tote .piece-c { display: none; }
.fashion-earrings .piece-a, .fashion-earrings .piece-b { top: 67rpx; width: 39rpx; height: 39rpx; border-radius: 50%; background: #e8d6a3; }
.fashion-earrings .piece-a { left: 51rpx; }.fashion-earrings .piece-b { right: 51rpx; }.fashion-earrings .piece-c { display: none; }
.fashion-scarf .piece-a { left: 50%; top: 46rpx; width: 98rpx; height: 92rpx; transform: translateX(-50%) rotate(12deg); border-radius: 45% 28% 48% 33%; }
.fashion-scarf .piece-b { left: 72rpx; top: 111rpx; width: 29rpx; height: 57rpx; transform: rotate(14deg); border-radius: 4rpx 4rpx 18rpx 18rpx; }
.fashion-scarf .piece-c { right: 69rpx; top: 111rpx; width: 29rpx; height: 57rpx; transform: rotate(-13deg); border-radius: 4rpx 4rpx 18rpx 18rpx; }
.fashion-jewelry .piece-a { left: 50%; top: 52rpx; width: 79rpx; height: 79rpx; transform: translateX(-50%); border: 4rpx solid var(--garment-dark); border-radius: 50%; background: transparent; }
.fashion-jewelry .piece-b { left: 50%; top: 122rpx; width: 22rpx; height: 22rpx; transform: translateX(-50%) rotate(45deg); border-radius: 3rpx; }.fashion-jewelry .piece-c { display: none; }
.outfit-caption { min-height: 87rpx; padding: 10rpx; font-size: 18rpx; }
.outfit-caption text:first-child { display: -webkit-box; overflow: hidden; white-space: normal; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.search-copy { width: 100%; min-height: 66rpx; margin: 18rpx 0 0; border: 1rpx solid #a99169; border-radius: 9rpx; background: transparent; color: #735f40; font-size: 20rpx; line-height: 66rpx; }
.plan-guide-list { margin-top: 24rpx; border-top: 1rpx solid #d8d0c0; }
.plan-guide-row { display: grid; grid-template-columns: 58rpx minmax(0, 1fr); gap: 15rpx; padding: 22rpx 2rpx; border-bottom: 1rpx solid #ddd5c7; color: #334b3d; font-size: 21rpx; line-height: 1.55; }
.plan-guide-row > view { display: flex; flex-direction: column; gap: 6rpx; }
.plan-guide-index { color: #aa8b5d; font-family: Georgia, serif; font-size: 18rpx; }
.prep-list { overflow: hidden; border: 1rpx solid #d7d0c1; border-radius: 14rpx; background: #fffcf7; }
.prep-row { display: grid; grid-template-columns: 28rpx minmax(0, 1fr); gap: 15rpx; padding: 20rpx 22rpx; border-bottom: 1rpx solid #e4ded2; color: #344c3e; font-size: 22rpx; line-height: 1.5; }
.prep-row:last-child { border-bottom: 0; }
.prep-check { width: 22rpx; height: 22rpx; margin-top: 5rpx; border: 2rpx solid #9d8a69; border-radius: 50%; }
.inline-note text { color: var(--accent); font-weight: 600; }
.public-wardrobe-row { grid-template-columns: 1fr auto; }

/* 穿搭页：把单品放进同一张平铺画板，避免六张占位卡片彼此割裂。 */
.flatlay-board { position: relative; height: 540rpx; overflow: hidden; border: 1rpx solid #d7cbb5; border-radius: 16rpx; background: radial-gradient(circle at 22% 15%, #fffdf8 0, #f4eee3 38%, transparent 39%), linear-gradient(135deg, #f2ebdf, #e7dece); box-shadow: inset 0 0 45rpx #8f7b5810; }
.flatlay-board::before { content: ''; position: absolute; left: -62rpx; bottom: -70rpx; width: 230rpx; height: 230rpx; border: 1rpx solid #a48d6650; border-radius: 50%; }
.flatlay-board::after { content: ''; position: absolute; right: 22rpx; top: 106rpx; width: 82rpx; height: 1rpx; background: #aa946b75; transform: rotate(-33deg); }
.flatlay-caption { position: absolute; z-index: 8; left: 22rpx; top: 19rpx; display: flex; flex-direction: column; gap: 3rpx; color: #87704e; font-size: 15rpx; letter-spacing: .08em; }
.flatlay-caption text:first-child { color: var(--accent); font-family: Georgia, serif; font-size: 19rpx; letter-spacing: .04em; }
.flatlay-stamp { position: absolute; z-index: 8; right: 18rpx; bottom: 16rpx; padding: 8rpx 10rpx; border: 1rpx solid #917b5860; color: #806c4b; font-family: Georgia, serif; font-size: 13rpx; line-height: 1.35; text-align: center; transform: rotate(-3deg); }
.flatlay-item { --garment: #d9cfb9; --garment-dark: #8f8067; position: absolute; z-index: 3; width: 190rpx; height: 190rpx; transform-origin: center; }
.flatlay-item .sketch-shadow { bottom: 18rpx; opacity: .72; }
.flatlay-item .sketch-line { top: 62rpx; }
.slot-outer { z-index: 1; left: 2rpx; top: 65rpx; transform: rotate(-9deg) scale(.88); opacity: .88; }
.slot-main { z-index: 4; left: 138rpx; top: 54rpx; transform: rotate(3deg) scale(.96); }
.slot-bottom { z-index: 3; left: 260rpx; top: 194rpx; transform: rotate(-3deg) scale(1.12); }
.slot-shoes { z-index: 5; left: 12rpx; top: 342rpx; transform: rotate(-8deg) scale(.92); }
.slot-bag { z-index: 5; right: 6rpx; top: 306rpx; transform: rotate(7deg) scale(.94); }
.slot-accent { z-index: 5; right: 8rpx; top: 57rpx; transform: rotate(6deg) scale(.76); }
.outfit-pick-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rpx 24rpx; margin-top: 20rpx; border-top: 1rpx solid #d8cfbe; }
.outfit-pick { min-width: 0; padding: 16rpx 0; display: grid; grid-template-columns: 18rpx minmax(0, 1fr) auto; align-items: center; gap: 10rpx; border-bottom: 1rpx solid #ded6c8; }
.outfit-swatch { --garment: #d9cfb9; display: block; width: 16rpx; height: 16rpx; border: 1rpx solid #8c816d; border-radius: 50%; background: var(--garment); }
.outfit-pick > view { min-width: 0; display: flex; flex-direction: column; gap: 3rpx; }
.outfit-pick-label { color: #99805b; font-size: 16rpx; }
.outfit-pick-name { overflow: hidden; color: #334b3d; font-size: 19rpx; line-height: 1.35; white-space: nowrap; text-overflow: ellipsis; }
.outfit-pick-state { color: #8c958b; font-size: 15rpx; }

/* 衣橱页：表单、已有单品和长期补充清单分别成区。 */
.profile-pills { padding: 0; flex-direction: row; flex-wrap: wrap; gap: 9rpx; background: transparent; }
.profile-pills text { padding: 9rpx 14rpx; border: 1rpx solid #ccd2c5; border-radius: 999rpx; background: var(--tint); color: #4c6656; font-size: 18rpx; }
.wardrobe-panel { margin-top: 28rpx; padding: 24rpx; border: 1rpx solid #d7d0c1; border-radius: 18rpx; background: #fcfaf5; box-shadow: 0 8rpx 24rpx #453b2610; }
.wardrobe-panel-head { margin: 0 0 20rpx; }
.wardrobe-form { display: grid; grid-template-columns: minmax(0, 1fr) 180rpx; gap: 12rpx; }
.wardrobe-form picker { grid-column: 1 / -1; }
.wardrobe-form input { box-sizing: border-box; min-width: 0; height: 76rpx; padding: 0 17rpx; border: 1rpx solid #c5cbbb; border-radius: 10rpx; background: #fffdf8; color: #2d4738; font-size: 22rpx; }
.wardrobe-form button { height: 76rpx; margin: 0; padding: 0; border-radius: 10rpx; background: var(--accent); color: #fff7e8; font-size: 21rpx; line-height: 76rpx; }
.wardrobe-form .category-picker { justify-content: space-between; min-height: 70rpx; padding: 0 18rpx; text-align: left; }
.category-picker-label { color: #9b815b; font-size: 18rpx; }
.wardrobe-list { margin-top: 17rpx; border-top: 1rpx solid #ddd6c8; }
.public-wardrobe-row { min-height: 86rpx; }
.wardrobe-dot { width: 13rpx; height: 13rpx; flex: none; border: 1rpx solid #8a7658; border-radius: 50%; background: #d9c8a8; }
.public-wardrobe-row .wardrobe-row-text text:first-child { color: #30493b; font-size: 22rpx; }
.public-wardrobe-row .wardrobe-row-text text:last-child { color: #9a835f; font-size: 17rpx; }
.public-wardrobe-row button { min-height: 52rpx; line-height: 52rpx; font-size: 18rpx; }
.wardrobe-panel .empty-wardrobe { padding: 39rpx 12rpx 25rpx; display: flex; flex-direction: column; gap: 6rpx; }
.wardrobe-panel .empty-wardrobe text:first-child { color: #506559; font-family: 'Songti SC', serif; font-size: 25rpx; }
.wardrobe-panel .empty-wardrobe text:last-child { color: #92998f; font-size: 19rpx; }
.wardrobe-gap-panel { margin-top: 22rpx; }
.wardrobe-gap-intro { display: block; margin: -4rpx 0 18rpx; color: #7d887f; font-size: 20rpx; line-height: 1.5; }
.budget-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 9rpx; padding: 5rpx; border-radius: 13rpx; background: #eee9df; }
.budget-tabs .chip { width: 100%; min-height: 62rpx; padding: 0 5rpx; border: 0; border-radius: 9rpx; background: transparent; font-size: 20rpx; line-height: 62rpx; }
.budget-tabs .chip.active { background: var(--accent); color: #fff7e8; box-shadow: 0 4rpx 12rpx #173b3020; }
.wardrobe-gap-list { margin-top: 18rpx; display: flex; flex-direction: column; gap: 10rpx; }
.wardrobe-gap-card { min-height: 0; padding: 19rpx; display: grid; grid-template-columns: 38rpx minmax(0, 1fr) auto; align-items: center; gap: 12rpx; border-radius: 12rpx; }
.wardrobe-gap-copy { min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }
.wardrobe-gap-name { overflow: hidden; font-size: 24rpx; white-space: nowrap; text-overflow: ellipsis; }
.wardrobe-gap-card button { align-self: center; min-height: 54rpx; margin: 0; padding: 0 14rpx; line-height: 54rpx; white-space: nowrap; }
.wardrobe-gap-empty { padding: 30rpx 12rpx !important; }
